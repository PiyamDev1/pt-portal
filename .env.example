NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Native passkeys are enabled/configured in Supabase Auth, not through an environment variable.
# Set the production RP ID and allowed origin to match NEXT_PUBLIC_SITE_URL; see Deployment Guide.

# Independent server-only pepper for hashing rate-limit identities before database storage.
# Generate a long random value; never expose it through a NEXT_PUBLIC_ variable.
RATE_LIMIT_HASH_SECRET=generate-a-long-independent-random-secret

# Public site URL (used for metadata, sitemap, verification links, and server fallbacks)
NEXT_PUBLIC_SITE_URL=https://piyamtravels.com

# Optional server-only override for absolute links created by cron jobs and PDF vouchers.
APP_BASE_URL=https://piyamtravels.com

# Required shared bearer secret for every /api/cron/* route. Vercel sends this value
# automatically in the Authorization header for configured cron jobs.
CRON_SECRET=generate-a-long-random-secret

# Optional public branding and customer-portal overrides.
NEXT_PUBLIC_APP_VERSION=web
NEXT_PUBLIC_PACKAGE_PORTAL_URL=https://bookings.piyamtravel.com
NEXT_PUBLIC_RECEIPT_ADDRESS_LINE1=Piyam Travels
NEXT_PUBLIC_RECEIPT_ADDRESS_LINE2="Serving UK & International Clients"

# Mailgun configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_SENDER_EMAIL="Piyam Travel <bookings.noreply@piyamtravel.com>"
# Optional Mailgun-compatible API origin; leave unchanged for Mailgun Cloud.
MAILGUN_ENDPOINT=https://api.mailgun.net

# Optional generated-receipt branding and verification-link override.
RECEIPT_COMPANY_NAME="Piyam Travel"
RECEIPT_VERIFY_BASE_URL=https://piyamtravels.com

# MinIO / EU Document Vault (server-side only — do NOT add NEXT_PUBLIC_ prefix)
MINIO_ENDPOINT=https://eu49v2.piyamtravel.com
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=portal-documents
MINIO_PACKAGES_BUCKET_NAME=pt-packages
MINIO_REGION=eu-west-1

# Optional document-vault fallback and migration worker authentication
R2_ENDPOINT=https://your-document-backup-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-document-backup-access-key
R2_SECRET_KEY=your-document-backup-secret-key
R2_BUCKET_NAME=portal-fallback
# Optional display/health endpoint when it differs from the S3 API endpoint.
R2_PING_URL=
# Optional dedicated artifact buckets; default to the document-vault buckets above.
ISSUE_REPORTS_MINIO_BUCKET_NAME=
ISSUE_REPORTS_R2_BUCKET_NAME=
DOCUMENT_MIGRATION_CRON_TOKEN=generate-a-long-random-secret

# Optional: set when the deployed environment needs a specific Chromium binary for PDF generation.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chromium

# MinIO endpoint exposed to the browser (for health checks and display only)
NEXT_PUBLIC_MINIO_ENDPOINT=https://eu49v2.piyamtravel.com

# Travel package backup storage.
# Named R3 inside PT-Portal so it does not conflict with existing document R2_* keys.
R3_ENDPOINT=https://your-package-backup-account.r2.cloudflarestorage.com
R3_PUBLIC_URL=https://your-package-backup-public-domain
R3_ACCESS_KEY_ID=your-package-backup-access-key-id
R3_SECRET_ACCESS_KEY=your-package-backup-secret-access-key
R3_BUCKET_NAME=pt-packages-backup

# Legacy bookings portal migration source.
# Copy values from the old bookings portal Firebase service account.
LEGACY_BOOKINGS_FIREBASE_PROJECT_ID=your-firebase-project-id
LEGACY_BOOKINGS_FIREBASE_CLIENT_EMAIL=your-firebase-client-email
LEGACY_BOOKINGS_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frappe HRMS integration (server-side only)
FRAPPE_BASE_URL=https://frio.piyamtravel.com
FRAPPE_API_KEY=your-frappe-integration-user-api-key
FRAPPE_API_SECRET=your-frappe-integration-user-api-secret
# Alternative to FRAPPE_API_KEY + FRAPPE_API_SECRET; configure one auth mode only.
FRAPPE_API_TOKEN=
FRAPPE_WEBHOOK_SECRET=your-shared-frappe-webhook-secret
FRAPPE_HANDOFF_SECRET=your-shared-ims-to-frappe-handoff-secret

# Optional reminder catch-up window, clamped by the route to 15-1440 minutes.
BOOKING_REMINDER_CRON_LOOKBACK_MINUTES=1440

# Server Control (server-side only, Super Admin UI)
HETZNER_API_TOKEN=your-hetzner-cloud-api-token
HETZNER_SERVER_ID=125153099
HETZNER_SERVER_IP=178.104.107.217,2a01:4f8:1c19:b70d::/64
HETZNER_SERVER_LABEL=Hetzner CX23 125153099
SERVER_CONTROL_SERVICES=Coolify,Chatwoot,Evolution API
SERVER_CONTROL_SERVICE_HEALTH_URLS=Coolify=http://178.104.107.217:8000,Chatwoot=https://hub.piyamtravel.com,Evolution API=https://gateway-hub.piyamtravel.com
# Optional trusted receiver for redacted operational alerts (shared limiter, LMS ledger, and document storage).
# Payloads include a request ID for correlation. Never expose this URL through a NEXT_PUBLIC_ variable.
OBSERVABILITY_ALERT_WEBHOOK_URL=

# Optional live Playwright smoke-suite configuration. Store production values as GitHub Actions
# repository secrets instead of committing them. TOTP is preferred because it is reusable;
# SMOKE_2FA_BACKUP_CODE is a one-time fallback and must be replaced after successful use.
SMOKE_BASE_URL=https://your-deployment.example.com
SMOKE_USER_EMAIL=smoke-user@example.com
SMOKE_USER_PASSWORD=your-smoke-user-password
SMOKE_USER_BRANCH_CODE=HQ-001
SMOKE_FAMILY_HEAD_ID=existing-test-family-scope
SMOKE_2FA_TOTP_SECRET=base32-authenticator-secret
SMOKE_2FA_BACKUP_CODE=

# Optional smoke coverage for configured live records/mutations.
SMOKE_LMS_ACCOUNT_ID=
SMOKE_PACKAGE_SHARE_TOKEN=
SMOKE_RUN_BATCH=false
SMOKE_RECEIPT_NADRA_ID=
SMOKE_RUN_RECEIPT_MUTATION=false
# AeroDataBox Ticketing flight monitoring (server-only)
AERODATABOX_API_KEY=
# Defaults to the RapidAPI AeroDataBox base. Override for a direct/API.Market subscription.
AERODATABOX_API_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
